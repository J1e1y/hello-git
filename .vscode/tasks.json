{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C: build and run current file",
      "type": "shell",
      "command": "gcc -Wall -Wextra -std=c11 \"${file}\" -o \"/tmp/${fileBasenameNoExtension}\" && \"/tmp/${fileBasenameNoExtension}\"",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": ["$gcc"]
    }
  ]
}